@model Example.UserService.WebApp.Models.PagedViewModel
@{
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling(Model.TotalItems / (double)Model.PageSize) : 0;
}
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.BuildPageUrl(Model.PageIndex - 1)">&laquo;</a>
            </li>
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" href="@Model.BuildPageUrl(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.PageIndex >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@Model.BuildPageUrl(Model.PageIndex + 1)">&raquo;</a>
            </li>
        </ul>
    </nav>
}
