@model Example.UserService.WebApp.Models.ExamSet.ExamSetDetailsViewModel
@using Example.Common.Utilities
@inject IExamSetService ExamSetService
@{
    var assignment = Model.Assignment;
    var exam = Model.ExamSet;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Kỳ thi của tôi</a></li>
        <li class="breadcrumb-item active">@assignment.ExamPeriodName</li>
    </ol>
</nav>

@if (Model.CanContinueExam && assignment.Status != (int)ExamPeriodAssignmentStatusEnum.Completed && Model.InProgressSessions.Any())
{
    <div class="alert alert-light border mb-3">
        Bạn có bài thi đang làm dở.
        @foreach (var session in Model.InProgressSessions)
        {
            <a asp-controller="ExamSession" asp-action="Take" asp-route-id="@session.Id" class="alert-link ms-2">
                Tiếp tục
            </a>
        }
    </div>
}

<div class="card exam-card">
    <div class="card-body p-4">
        <h3 class="mb-2 fw-semibold">@assignment.ExamPeriodName</h3>
        <p class="text-muted small mb-3">
            @ExamSetService.GetExamTypeName(assignment.ExamType)
            · @Model.PeriodStatusName
            · @Model.DisplayStatusName
        </p>

        @if (assignment.ExamPeriodStartAt.HasValue && assignment.ExamPeriodEndAt.HasValue)
        {
            <p class="text-muted">
                <i class="fas fa-clock me-1"></i>
                @VietnamTimeHelper.ToDisplayString(assignment.ExamPeriodStartAt.Value)
                -
                @VietnamTimeHelper.ToDisplayString(assignment.ExamPeriodEndAt.Value)
            </p>
        }

        <div class="border rounded p-3 mb-4 bg-light">
            <div class="text-muted small">Bộ đề</div>
            @if (exam != null)
            {
                <div class="fw-bold">@exam.Name</div>
                <div class="small text-muted mt-1">@exam.QuestionCount câu · @exam.DurationMinutes phút · @exam.RequiredTotalPoints điểm</div>
            }
            else
            {
                <div class="fw-bold">Ngẫu nhiên từ danh sách bộ đề của kỳ thi</div>
                <div class="small text-muted mt-1">Bộ đề sẽ được chọn khi bạn bấm bắt đầu thi.</div>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">
            @{
                var isCompleted = assignment.Status == (int)ExamPeriodAssignmentStatusEnum.Completed;
                var isCancelled = assignment.Status == (int)ExamPeriodAssignmentStatusEnum.Cancelled;
                var inProgressSession = Model.InProgressSessions.FirstOrDefault();
            }
            @if (isCancelled)
            {
                <span class="text-danger"><i class="fas fa-ban me-1"></i>Bài thi bị hủy do vi phạm quy chế</span>
            }
            else if (isCompleted)
            {
                <span class="text-muted"><i class="fas fa-check-circle me-1"></i>Đã hoàn thành</span>
            }
            else if (!Model.CanContinueExam)
            {
                <span class="text-muted">
                    <i class="fas fa-lock me-1"></i>Kỳ thi đã kết thúc
                </span>
            }
            else if (!Model.CanStartExam && inProgressSession == null)
            {
                <span class="text-muted">
                    <i class="fas fa-clock me-1"></i>Chưa đến thời gian bắt đầu thi
                </span>
            }
            else if (inProgressSession != null)
            {
                <a asp-controller="ExamSession" asp-action="Take" asp-route-id="@inProgressSession.Id" class="btn btn-primary">
                    Tiếp tục làm bài
                </a>
            }
            else if (Model.CanStartExam)
            {
                <form asp-controller="ExamSession" asp-action="Start" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examSetId" value="0" />
                    <input type="hidden" name="examType" value="@assignment.ExamType" />
                    <input type="hidden" name="examPeriodAssignmentId" value="@assignment.Id" />
                    <button type="submit" class="btn btn-primary">
                        Bắt đầu @ExamSetService.GetExamTypeName(assignment.ExamType)
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </div>
</div>
