@model Example.UserService.WebApp.Models.Home.DashboardViewModel
@{
    var displayName = Model.FullName ?? Model.Username ?? "Thí sinh";
}

<div class="dashboard-hero">
    <div class="dashboard-hero-content">
        <div class="dashboard-hero-text">
            <p class="dashboard-greeting mb-1">Xin chào</p>
            <h2 class="dashboard-name mb-1">@displayName</h2>
            <p class="dashboard-subtitle mb-0">Tổng quan kỳ thi và tiến độ làm bài của bạn.</p>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning border-0">@Model.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="ExamSet" asp-action="Index" class="stat-card-link">
            <div class="card stat-card stat-card-primary h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3 px-3">
                    <div class="stat-icon-wrap stat-icon-primary">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="stat-label">Kỳ thi được phân</div>
                        <div class="stat-value">@Model.TotalExamSets</div>
                    </div>
                    <i class="fas fa-chevron-right stat-arrow"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="ExamSession" asp-action="Index" class="stat-card-link">
            <div class="card stat-card stat-card-warning h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="stat-icon-wrap stat-icon-warning">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="stat-label">Đang làm dở</div>
                        <div class="stat-value">@Model.InProgressSessions</div>
                    </div>
                    <i class="fas fa-chevron-right stat-arrow"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="ExamSession" asp-action="History" class="stat-card-link">
            <div class="card stat-card stat-card-success h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="stat-icon-wrap stat-icon-success">
                        <i class="fas fa-check"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="stat-label">Đã hoàn thành</div>
                        <div class="stat-value">@Model.CompletedSessions</div>
                    </div>
                    <i class="fas fa-chevron-right stat-arrow"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card action-card action-card-primary h-100">
            <div class="action-card-accent"></div>
            <div class="card-body p-4 d-flex flex-column">
                <div class="action-icon-wrap mb-3">
                    <i class="fas fa-book-open"></i>
                </div>
                <h5 class="action-title">Bắt đầu làm bài</h5>
                <p class="action-desc flex-grow-1">Xem danh sách kỳ thi được phân công và bắt đầu khi đến thời gian.</p>
                <a asp-controller="ExamSet" asp-action="Index" class="btn btn-primary action-btn">
                    Xem kỳ thi
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card action-card action-card-warning h-100">
            <div class="action-card-accent"></div>
            <div class="card-body p-4 d-flex flex-column">
                <div class="action-icon-wrap mb-3">
                    <i class="fas fa-play"></i>
                </div>
                <h5 class="action-title">Tiếp tục làm bài</h5>
                <p class="action-desc">Các bài thi chưa nộp, có thể tiếp tục từ phần đã lưu.</p>

                @if (Model.RecentInProgress.Count > 0)
                {
                    <div class="dashboard-mini-list mb-3">
                        @foreach (var item in Model.RecentInProgress.Take(3))
                        {
                            <a asp-controller="ExamSession" asp-action="Take" asp-route-id="@item.Id" class="mini-list-item">
                                <div class="mini-list-info">
                                    <span class="mini-list-title">@item.ExamSetName</span>
                                    <span class="mini-list-meta">
                                        @(item.ExamType == (int)ExamTypeEnum.Trial ? "Thi thử" : "Thi chính thức")
                                        · @item.StartedAt.ToString("dd/MM HH:mm")
                                    </span>
                                </div>
                                <span class="mini-list-action"><i class="fas fa-chevron-right"></i></span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-hint mb-3">
                        Không có bài thi đang làm dở
                    </div>
                }

                <a asp-controller="ExamSession" asp-action="Index" class="btn btn-outline-primary action-btn mt-auto">
                    Tất cả (@Model.InProgressSessions)
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card action-card action-card-success h-100">
            <div class="action-card-accent"></div>
            <div class="card-body p-4 d-flex flex-column">
                <div class="action-icon-wrap mb-3">
                    <i class="fas fa-clock-rotate-left"></i>
                </div>
                <h5 class="action-title">Lịch sử kết quả</h5>
                <p class="action-desc">Xem lại điểm và chi tiết các bài đã nộp.</p>

                @if (Model.RecentCompleted.Count > 0)
                {
                    <div class="dashboard-mini-list mb-3">
                        @foreach (var item in Model.RecentCompleted.Take(3))
                        {
                            var pct = item.MaxScore > 0
                                ? Math.Round((double)item.TotalScore / (double)item.MaxScore * 100, 0)
                                : 0;
                            var pctClass = pct >= 80 ? "score-high" : pct >= 50 ? "score-mid" : "score-low";
                            <a asp-controller="ExamSession" asp-action="Details" asp-route-id="@item.Id" class="mini-list-item">
                                <div class="mini-list-info">
                                    <span class="mini-list-title">@item.ExamSetName</span>
                                    <span class="mini-list-meta">@item.FinishedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <span class="mini-list-score @pctClass">@item.TotalScore.ToString("0.##")/@item.MaxScore.ToString("0.##")</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-hint mb-3">
                        Chưa có kết quả nào
                    </div>
                }

                <a asp-controller="ExamSession" asp-action="History" class="btn btn-outline-primary action-btn mt-auto">
                    Xem lịch sử
                </a>
            </div>
        </div>
    </div>
</div>
