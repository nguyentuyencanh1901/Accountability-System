@model Example.UserService.WebAdmin.Models.ExamSessionAnswerOption.ExamSessionAnswerOptionIndexViewModel
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-check-square"></i> Danh sách đáp án đã chọn</h3>
        <div class="card-tools"><a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a></div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <form method="get" class="form-inline mb-3">
            <label class="mr-2">Câu trả lời:</label>
            <select name="examSessionAnswerId" asp-items="Model.ExamSessionAnswerFilterOptions" class="form-control form-control-sm mr-2" onchange="this.form.submit()"></select>
            <label class="mr-2 ml-2">Đáp án:</label>
            <select name="answerOptionId" asp-items="Model.AnswerOptionFilterOptions" class="form-control form-control-sm mr-2" onchange="this.form.submit()"></select>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr><th>ID</th><th>Câu trả lời</th><th>Đáp án</th><th width="120">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0) { <tr><td colspan="4" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ExamSessionAnswerInfo</td>
                            <td>@item.AnswerOptionContent</td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa đáp án đã chọn?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
