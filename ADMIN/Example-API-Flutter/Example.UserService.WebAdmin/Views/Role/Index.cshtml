@model Example.UserService.WebAdmin.Models.Role.RoleIndexViewModel
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-user-shield"></i> Danh sách vai trò</h3>
        <div class="card-tools"><a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a></div>
    </div>
    <div class="card-body table-responsive">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <table class="table table-bordered table-hover">
            <thead class="thead-light"><tr><th>ID</th><th>Tên vai trò</th><th>Số quyền</th><th width="120">Thao tác</th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="4" class="text-center text-muted">Không có dữ liệu</td></tr> }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.PermissionCount</td>
                        <td class="table-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa vai trò?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
