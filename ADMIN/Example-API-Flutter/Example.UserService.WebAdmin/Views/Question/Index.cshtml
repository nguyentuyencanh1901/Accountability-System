@model Example.UserService.WebAdmin.Models.Question.QuestionIndexViewModel
@using Example.Common.Enums
@using Example.Common.Utilities.Helper
@using Example.UserService.WebAdmin.Helpers
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-question-circle"></i> Quản lý câu hỏi</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <form method="get" class="mb-3">
            <div class="row">
                <div class="col-md-4">
                    <select name="fieldId" asp-items="Model.FieldFilterOptions" class="form-control form-control-sm"></select>
                </div>
                <div class="col-md-3">
                    <select name="questionType" asp-items="Model.QuestionTypeFilterOptions" class="form-control form-control-sm"></select>
                </div>
                <div class="col-md-3">
                    <select name="difficultyLevel" asp-items="Model.DifficultyFilterOptions" class="form-control form-control-sm"></select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary btn-sm btn-block"><i class="fas fa-filter"></i> Lọc</button>
                </div>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th width="90">Ảnh</th>
                        <th>Lĩnh vực</th>
                        <th>Nội dung</th>
                        <th>Điểm</th>
                        <th>Loại</th>
                        <th>Độ khó</th>
                        <th>Trạng thái</th>
                        <th width="160">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0) { <tr><td colspan="9" class="text-center text-muted">Không có câu hỏi nào</td></tr> }
                    @foreach (var item in Model.Items)
                    {
                        var difficulty = item.DifficultyLevel switch
                        {
                            (int)DifficultyLevelEnum.Easy => "Dễ",
                            (int)DifficultyLevelEnum.Hard => "Khó",
                            _ => "Trung bình"
                        };
                        var imageUrl = EntityImageHelper.BuildPublicUrl(item.ImageUrl, Model.ApiBaseUrl);
                        <tr>
                            <td>@item.Id</td>
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <a href="@imageUrl" target="_blank" title="Xem ảnh">
                                        <img src="@imageUrl" alt="Ảnh câu hỏi #@item.Id" class="img-thumbnail" style="max-height: 56px; max-width: 72px; object-fit: cover;" />
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.FieldName) ? "—" : item.FieldName)</td>
                            <td>@((item.Content?.Length > 60) ? item.Content[..60] + "..." : item.Content)</td>
                            <td>@item.Points</td>
                            <td>@(item.QuestionType == (int)QuestionTypeEnum.SingleChoice ? "Một đáp án" : "Nhiều đáp án")</td>
                            <td>@difficulty</td>
                            <td style="min-width: 170px;">
                                <form asp-action="UpdateStatus" method="post" class="d-inline js-inline-status-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                                    <input type="hidden" name="fieldId" value="@Model.FieldIdFilter" />
                                    <input type="hidden" name="questionType" value="@Model.QuestionTypeFilter" />
                                    <input type="hidden" name="difficultyLevel" value="@Model.DifficultyLevelFilter" />
                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                    <select name="status" class="form-control form-control-sm d-inline-block js-inline-status" style="width: 160px;">
                                        @foreach (var opt in SelectListHelper.Statuses(item.Status))
                                        {
                                            <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                                        }
                                    </select>
                                </form>
                            </td>
                            <td class="table-actions">
                                <a asp-controller="AnswerOption" asp-action="Index" asp-route-questionId="@item.Id"
                                   class="btn btn-success btn-xs" title="Đáp án">
                                    <i class="fas fa-check-circle"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs" title="Sửa"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa câu hỏi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-xs" title="Xóa"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('change', function (e) {
                var el = e.target;
                if (!el || !el.classList || !el.classList.contains('js-inline-status')) return;
                var form = el.closest('form');
                if (!form) return;
                if (!confirm('Cập nhật trạng thái?')) return;
                form.submit();
            });
        })();
    </script>
}
