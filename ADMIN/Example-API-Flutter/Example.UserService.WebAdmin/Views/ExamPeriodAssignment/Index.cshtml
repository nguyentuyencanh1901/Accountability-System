@model Example.UserService.WebAdmin.Models.ExamPeriodAssignment.ExamPeriodAssignmentIndexViewModel
@inject IExamPeriodAssignmentService ExamPeriodAssignmentService
@using Example.UserService.WebAdmin.Helpers
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-check"></i>
            Phân công thi
            @if (!string.IsNullOrWhiteSpace(Model.ExamPeriodName))
            {
                <span class="text-muted">— @Model.ExamPeriodName</span>
            }
        </h3>
        <div class="card-tools">
            <a asp-controller="ExamPeriod" asp-action="Index" class="btn btn-secondary btn-sm mr-1"><i class="fas fa-arrow-left"></i> Kỳ thi</a>
            <a asp-action="Create" asp-route-examPeriodId="@Model.ExamPeriodId" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm phân công</a>
        </div>
    </div>
    <div class="card-body table-responsive">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <table class="table table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>ID</th>
                    <th>Kỳ thi</th>
                    <th>Thí sinh</th>
                    <th>Bộ đề</th>
                    <th>Loại thi</th>
                    <th>Trạng thái</th>
                    <th width="120">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr> }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.ExamPeriodName</td>
                        <td>@item.UserFullName</td>
                        <td>@item.ExamSetName</td>
                        <td>@ExamPeriodAssignmentService.GetExamTypeName(item.ExamType)</td>
                        <td style="min-width: 170px;">
                            <form asp-action="UpdateStatus" method="post" class="d-inline js-inline-status-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                                <input type="hidden" name="examPeriodId" value="@Model.ExamPeriodId" />
                                <select name="status" class="form-control form-control-sm d-inline-block js-inline-status" style="width: 160px;">
                                    @foreach (var opt in SelectListHelper.ExamPeriodAssignmentStatuses(item.Status))
                                    {
                                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td class="table-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" asp-route-examPeriodId="@Model.ExamPeriodId" method="post" class="d-inline" onsubmit="return confirm('Xóa phân công?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('change', function (e) {
                var el = e.target;
                if (!el || !el.classList || !el.classList.contains('js-inline-status')) return;
                var form = el.closest('form');
                if (!form) return;
                if (!confirm('Cập nhật trạng thái?')) return;
                form.submit();
            });
        })();
    </script>
}
