@model Example.UserService.WebAdmin.Models.ExamSet.ExamSetIndexViewModel
@using Example.Common.Enums
@using Example.UserService.WebAdmin.Helpers
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-book"></i> Danh sách bộ đề thi</h3>
        <div class="card-tools"><a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a></div>
    </div>
    <div class="card-body table-responsive">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <table class="table table-bordered table-hover">
            <thead class="thead-light">
                <tr>
                    <th>ID</th>
                    <th>Tên bộ đề</th>
                    <th>Loại</th>
                    <th>Số câu</th>
                    <th>Dễ/TB/Khó</th>
                    <th>Thời gian</th>
                    <th>Tổng điểm</th>
                    <th>Trạng thái</th>
                    <th width="200">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="9" class="text-center text-muted">Không có dữ liệu</td></tr> }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@(item.Type == (int)ExamSetTypeEnum.Trial ? "Thi thử" : "Thi thật")</td>
                        <td>@item.QuestionCount</td>
                        <td>@item.EasyCount / @item.MediumCount / @item.HardCount</td>
                        <td>@item.DurationMinutes phút</td>
                        <td>@item.RequiredTotalPoints</td>
                        <td style="min-width: 170px;">
                            <form asp-action="UpdateStatus" method="post" class="d-inline js-inline-status-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                                <select name="status" class="form-control form-control-sm d-inline-block js-inline-status" style="width: 160px;">
                                    @foreach (var opt in SelectListHelper.Statuses(item.Status))
                                    {
                                        <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td class="table-actions">
                            <a asp-action="Takers" asp-route-id="@item.Id" class="btn btn-success btn-xs" title="Xem thí sinh đã thi"><i class="fas fa-users"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs" title="Sửa"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa bộ đề?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-xs" title="Xóa"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('change', function (e) {
                var el = e.target;
                if (!el || !el.classList || !el.classList.contains('js-inline-status')) return;
                var form = el.closest('form');
                if (!form) return;
                if (!confirm('Cập nhật trạng thái?')) return;
                form.submit();
            });
        })();
    </script>
}
