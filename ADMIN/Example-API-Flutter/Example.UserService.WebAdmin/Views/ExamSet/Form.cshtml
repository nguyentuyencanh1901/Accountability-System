@model Example.UserService.WebAdmin.Models.ExamSet.ExamSetFormViewModel
@using Example.Common.Enums
<div class="card card-primary">
    <div class="card-header"><h3 class="card-title">@(Model.IsEdit ? "Sửa" : "Thêm") bộ đề thi</h3></div>
    <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" id="examset-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row">
                <div class="col-md-8">
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Type"></label>
                        <select asp-for="Type" asp-items="Model.TypeOptions" class="form-control"></select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <h5 class="mt-3"><i class="fas fa-layer-group"></i> Lĩnh vực lấy câu hỏi</h5>
            <p class="text-muted small">Chọn một hoặc nhiều lĩnh vực — hệ thống random câu hỏi từ ngân hàng các lĩnh vực đã chọn.</p>
            <div class="row">
                @foreach (var field in Model.FieldOptions)
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="custom-control custom-checkbox mb-2">
                            <input type="checkbox" class="custom-control-input field-checkbox" name="FieldIds" value="@field.Id" id="field_@field.Id" @(field.Selected ? "checked" : "") />
                            <label class="custom-control-label" for="field_@field.Id">@field.Name</label>
                        </div>
                    </div>
                }
            </div>

            <h5 class="mt-3"><i class="fas fa-sliders-h"></i> Cấu hình đề</h5>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="QuestionCount"></label>
                        <input asp-for="QuestionCount" class="form-control" type="number" min="1" id="question-count" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="RequiredTotalPoints"></label>
                        <input asp-for="RequiredTotalPoints" class="form-control" type="number" min="1" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="DurationMinutes"></label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" min="1" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="Status"></label>
                        <select asp-for="Status" asp-items="Model.StatusOptions" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="EasyCount"></label>
                        <input asp-for="EasyCount" class="form-control difficulty-count" type="number" min="0" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="MediumCount"></label>
                        <input asp-for="MediumCount" class="form-control difficulty-count" type="number" min="0" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="HardCount"></label>
                        <input asp-for="HardCount" class="form-control difficulty-count" type="number" min="0" />
                    </div>
                </div>
            </div>
            <p class="text-muted small mb-0">
                Tổng Dễ + Trung bình + Khó phải <strong>bằng</strong> số câu hỏi.
                Khi lưu / khi thi, hệ thống kiểm tra có đủ câu trong ngân hàng và ghép đúng <strong>tổng điểm yêu cầu</strong>.
            </p>
            <div id="difficulty-warning" class="alert alert-warning mt-2 d-none"></div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const questionCount = document.getElementById('question-count');
            const difficultyInputs = document.querySelectorAll('.difficulty-count');
            const warning = document.getElementById('difficulty-warning');
            const form = document.getElementById('examset-form');

            function validateDifficulty() {
                const total = parseInt(questionCount.value, 10) || 0;
                const sum = Array.from(difficultyInputs).reduce((s, el) => s + (parseInt(el.value, 10) || 0), 0);
                if (total > 0 && sum !== total) {
                    warning.textContent = `Tổng câu theo độ khó (${sum}) phải bằng số câu hỏi (${total}).`;
                    warning.classList.remove('d-none');
                    return false;
                }
                warning.classList.add('d-none');
                return true;
            }

            questionCount.addEventListener('input', validateDifficulty);
            difficultyInputs.forEach(el => el.addEventListener('input', validateDifficulty));
            form.addEventListener('submit', function (e) {
                const checkedFields = form.querySelectorAll('.field-checkbox:checked');
                if (checkedFields.length === 0) {
                    e.preventDefault();
                    alert('Vui lòng chọn ít nhất một lĩnh vực.');
                    return;
                }
                if (!validateDifficulty()) {
                    e.preventDefault();
                }
            });
            validateDifficulty();
        })();
    </script>
}
