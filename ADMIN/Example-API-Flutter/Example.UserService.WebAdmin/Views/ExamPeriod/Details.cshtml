@model Example.UserService.WebAdmin.Models.ExamPeriod.ExamPeriodDetailViewModel
@using Example.Common.Enums
@using Example.Common.Utilities
@using Example.UserService.WebAdmin.Helpers
@inject IExamPeriodService ExamPeriodService
@inject IExamPeriodAssignmentService AssignmentService
@{
    var period = Model.Period!;
    string StatusBadgeClass(int status) => status switch
    {
        (int)ExamPeriodAssignmentStatusEnum.Assigned => "badge-secondary",
        (int)ExamPeriodAssignmentStatusEnum.InProgress => "badge-warning",
        (int)ExamPeriodAssignmentStatusEnum.Completed => "badge-success",
        (int)ExamPeriodAssignmentStatusEnum.Absent => "badge-danger",
        _ => "badge-light"
    };
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-chart-line"></i> Theo dõi kỳ thi: @period.Name</h3>
        <div class="card-tools">
            <a asp-action="Edit" asp-route-id="@period.Id" class="btn btn-info btn-sm mr-1"><i class="fas fa-edit"></i> Sửa kỳ thi</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Quay lại</a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <dl class="row mb-4">
            <dt class="col-sm-2">Thời gian</dt>
            <dd class="col-sm-10">@VietnamTimeHelper.ToDisplayString(period.StartAt) — @VietnamTimeHelper.ToDisplayString(period.EndAt)</dd>
            <dt class="col-sm-2">Trạng thái kỳ thi</dt>
            <dd class="col-sm-10">@ExamPeriodService.GetStatusName(period.Status)</dd>
            <dt class="col-sm-2">Tổng phân công</dt>
            <dd class="col-sm-10">@(Model.AssignedCount + Model.InProgressCount + Model.CompletedCount + Model.AbsentCount)</dd>
        </dl>

        <div class="row mb-4">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-secondary">
                    <div class="inner">
                        <h3>@Model.AssignedCount</h3>
                        <p>Chưa thi</p>
                    </div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                    <a asp-action="Details" asp-route-id="@period.Id" asp-route-status="@((int)ExamPeriodAssignmentStatusEnum.Assigned)" class="small-box-footer">Lọc <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.InProgressCount</h3>
                        <p>Đang thi</p>
                    </div>
                    <div class="icon"><i class="fas fa-spinner"></i></div>
                    <a asp-action="Details" asp-route-id="@period.Id" asp-route-status="@((int)ExamPeriodAssignmentStatusEnum.InProgress)" class="small-box-footer">Lọc <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@Model.CompletedCount</h3>
                        <p>Đã nộp bài</p>
                    </div>
                    <div class="icon"><i class="fas fa-check-circle"></i></div>
                    <a asp-action="Details" asp-route-id="@period.Id" asp-route-status="@((int)ExamPeriodAssignmentStatusEnum.Completed)" class="small-box-footer">Lọc <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@Model.AbsentCount</h3>
                        <p>Vắng thi</p>
                    </div>
                    <div class="icon"><i class="fas fa-user-times"></i></div>
                    <a asp-action="Details" asp-route-id="@period.Id" asp-route-status="@((int)ExamPeriodAssignmentStatusEnum.Absent)" class="small-box-footer">Lọc <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
        </div>

        <form method="get" asp-action="Details" class="form-inline mb-3">
            <input type="hidden" name="id" value="@period.Id" />
            <label class="mr-2">Lọc:</label>
            <select name="status" class="form-control form-control-sm mr-2">
                <option value="">— Trạng thái —</option>
                @foreach (var opt in SelectListHelper.ExamPeriodAssignmentStatuses(Model.FilterStatus ?? 0))
                {
                    <option value="@opt.Value" selected="@(Model.FilterStatus?.ToString() == opt.Value)">@opt.Text</option>
                }
            </select>
            <select name="examType" class="form-control form-control-sm mr-2">
                <option value="">— Loại thi —</option>
                @foreach (var opt in SelectListHelper.ExamTypes(Model.FilterExamType ?? 0))
                {
                    <option value="@opt.Value" selected="@(Model.FilterExamType?.ToString() == opt.Value)">@opt.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm mr-1"><i class="fas fa-filter"></i> Áp dụng</button>
            <a asp-action="Details" asp-route-id="@period.Id" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-sm">
                <thead class="thead-light">
                    <tr>
                        <th>Thí sinh</th>
                        <th>Bộ đề</th>
                        <th>Loại thi</th>
                        <th>Trạng thái</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                        <th>Thời gian làm</th>
                        <th>Điểm</th>
                        <th width="60"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Assignments.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted">Không có dữ liệu phù hợp bộ lọc.</td></tr>
                    }
                    @foreach (var item in Model.Assignments)
                    {
                        <tr>
                            <td>@item.UserFullName</td>
                            <td>@item.ExamSetName</td>
                            <td>@AssignmentService.GetExamTypeName(item.ExamType)</td>
                            <td><span class="badge @StatusBadgeClass(item.Status)">@AssignmentService.GetStatusName(item.Status)</span></td>
                            <td>@(item.SessionStartedAt.HasValue ? VietnamTimeHelper.ToDisplayString(item.SessionStartedAt.Value) : "-")</td>
                            <td>@(item.SessionFinishedAt.HasValue ? VietnamTimeHelper.ToDisplayString(item.SessionFinishedAt.Value) : "-")</td>
                            <td>@ExamPeriodService.FormatDuration(item.SessionStartedAt, item.SessionFinishedAt)</td>
                            <td>
                                @if (item.SessionTotalScore.HasValue && item.SessionMaxScore.HasValue)
                                {
                                    <text>@item.SessionTotalScore / @item.SessionMaxScore</text>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td class="table-actions">
                                @if (item.ExamSessionId > 0)
                                {
                                    <a asp-controller="ExamSession" asp-action="Details" asp-route-id="@item.ExamSessionId" class="btn btn-info btn-xs" title="Chi tiết bài thi"><i class="fas fa-eye"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
