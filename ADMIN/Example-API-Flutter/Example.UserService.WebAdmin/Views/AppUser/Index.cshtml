@model Example.UserService.WebAdmin.Models.AppUser.AppUserIndexViewModel
@using Example.Common.Enums
@using Example.UserService.WebAdmin.Helpers
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-users"></i> Danh sách người dùng</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <form method="get" class="form-inline mb-3">
            <label class="mr-2">Loại:</label>
            <select name="userType" class="form-control form-control-sm mr-2" onchange="this.form.submit()">
                <option value="0" selected="@(Model.UserTypeFilter == 0)">Tất cả</option>
                <option value="1" selected="@(Model.UserTypeFilter == 1)">Quản lý</option>
                <option value="2" selected="@(Model.UserTypeFilter == 2)">Người thi</option>
            </select>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên đăng nhập</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Loại</th>
                        <th>Trạng thái</th>
                        <th width="170">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Username</td>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@(item.UserType == (int)UserTypeEnum.Manager ? "Quản lý" : "Người thi")</td>
                            <td style="min-width: 170px;">
                                @if (item.IsSuperAdmin)
                                {
                                    <span class="text-muted small"><i class="fas fa-shield-alt"></i> @DisplayHelper.StatusName(item.Status)</span>
                                }
                                else
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline js-inline-status-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="pageIndex" value="@Model.PageIndex" />
                                        <input type="hidden" name="userType" value="@Model.UserTypeFilter" />
                                        <select name="status" class="form-control form-control-sm d-inline-block js-inline-status" style="width: 160px;">
                                            @foreach (var opt in SelectListHelper.Statuses(item.Status))
                                            {
                                                <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                                            }
                                        </select>
                                    </form>
                                }
                            </td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs" title="Sửa"><i class="fas fa-edit"></i></a>
                                @if (!item.IsSuperAdmin)
                                {
                                    <a asp-action="ResetPassword" asp-route-id="@item.Id" class="btn btn-warning btn-xs" title="Reset mật khẩu"><i class="fas fa-undo"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa người dùng này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-xs" title="Xóa"><i class="fas fa-trash"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small" title="SUPER_ADMIN — không xóa/reset mật khẩu"><i class="fas fa-shield-alt"></i></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.addEventListener('change', function (e) {
                var el = e.target;
                if (!el || !el.classList || !el.classList.contains('js-inline-status')) return;
                var form = el.closest('form');
                if (!form) return;
                if (!confirm('Cập nhật trạng thái?')) return;
                form.submit();
            });
        })();
    </script>
}
