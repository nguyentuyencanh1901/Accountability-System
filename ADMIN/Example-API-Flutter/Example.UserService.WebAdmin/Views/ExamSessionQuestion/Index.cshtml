@model Example.UserService.WebAdmin.Models.ExamSessionQuestion.ExamSessionQuestionIndexViewModel
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-list-ol"></i> Danh sách câu hỏi bài thi</h3>
        <div class="card-tools"><a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a></div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <form method="get" class="form-inline mb-3">
            <label class="mr-2">Bài thi:</label>
            <select name="examSessionId" asp-items="Model.ExamSessionFilterOptions" class="form-control form-control-sm mr-2" onchange="this.form.submit()"></select>
            <label class="mr-2 ml-2">Câu hỏi:</label>
            <select name="questionId" asp-items="Model.QuestionFilterOptions" class="form-control form-control-sm mr-2" onchange="this.form.submit()"></select>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr><th>ID</th><th>Bài thi</th><th>Câu hỏi</th><th>Điểm</th><th>Thứ tự</th><th width="120">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-muted">Không có dữ liệu</td></tr> }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ExamSessionInfo</td>
                            <td>@((item.Content?.Length > 60) ? item.Content[..60] + "..." : item.Content)</td>
                            <td>@item.Points</td>
                            <td>@item.SortOrder</td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa câu hỏi bài thi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
