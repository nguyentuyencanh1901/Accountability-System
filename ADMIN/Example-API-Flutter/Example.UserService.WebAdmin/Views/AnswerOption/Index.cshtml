@model Example.UserService.WebAdmin.Models.AnswerOption.AnswerOptionIndexViewModel
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb bg-transparent p-0">
        <li class="breadcrumb-item"><a asp-controller="Question" asp-action="Index">Câu hỏi</a></li>
        @if (!string.IsNullOrWhiteSpace(Model.FieldName))
        {
            <li class="breadcrumb-item"><a asp-controller="Question" asp-action="Index" asp-route-fieldId="@Model.FieldId">@Model.FieldName</a></li>
        }
        <li class="breadcrumb-item active">Câu #@Model.QuestionId</li>
        <li class="breadcrumb-item active">Đáp án</li>
    </ol>
</nav>
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-check-circle"></i> Đáp án</h3>
        <div class="card-tools">
            <a asp-controller="Question" asp-action="Index" class="btn btn-secondary btn-sm mr-1"><i class="fas fa-arrow-left"></i> Câu hỏi</a>
            <a asp-action="Create" asp-route-questionId="@Model.QuestionId" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Thêm mới</a>
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.QuestionContent))
        {
            <div class="alert alert-light border mb-3">
                <strong>Câu hỏi:</strong> @Model.QuestionContent
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr><th>ID</th><th>Nội dung</th><th>Đúng</th><th>Thứ tự</th><th width="120">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted">Chưa có đáp án nào</td></tr> }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Content</td>
                            <td>@(item.IsCorrect ? "Có" : "Không")</td>
                            <td>@item.SortOrder</td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-xs" title="Sửa"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@item.Id" asp-route-questionId="@Model.QuestionId" method="post" class="d-inline" onsubmit="return confirm('Xóa đáp án?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-xs" title="Xóa"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
